# Database
# Using SQLite for local development - change to PostgreSQL for production
DATABASE_URL=sqlite+aiosqlite:///./data/olx_data.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/olx_data.log

# Scraper
HEADLESS=true
SCRAPE_DELAY_MS=1000
MAX_CONCURRENT_PAGES=3

# Enrichment
GSMARENA_RATE_LIMIT=2.0
MIN_MATCH_CONFIDENCE=0.5

# Fraud Detection
FRAUD_HIGH_RISK_THRESHOLD=0.6
FRAUD_CRITICAL_THRESHOLD=0.8

# Pricing
MIN_SAMPLES_FOR_STATS=3
PRICE_STATS_DAYS_BACK=90

# Analytics
REPORT_OUTPUT_DIR=reports